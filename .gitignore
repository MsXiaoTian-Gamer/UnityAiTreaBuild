# ================= Unity 标准 .gitignore =================
# 缓存与生成物（严禁提交，避免 GB 级缓存上传）

# Unity 生成的文件夹
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/

# Unity 生成的 IDE 工程文件（由 Unity 自动重新生成）
*.csproj
*.sln
*.slnx
*.unityproj
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity 自动生成的 .meta 备份
*.csproj.meta
*.unityproj.meta
*.sln.meta
*.slnx.meta

# 崩溃与日志
mono_crash.*.json
crashlytics-build.properties
*.log

# 系统与编辑器文件
.DS_Store
.idea/
.vs/
.vscode/
*.swp
*.swo
*~

# 代码覆盖率
coverage/
*.coverage
*.coverage.xml

# 插件/资源缓存
Assets/AssetStoreTools*
